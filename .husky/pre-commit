#!/bin/sh
set -eu

export JWT_SECRET=test
export POSTGRES_URL=postgres://postgres:postgres@localhost:5432/skaia_db?sslmode=disable
export REDIS_URL=redis://localhost:6379/0

go run ./cmd/checktextpolicy

git ls-files '*go.mod' | while IFS= read -r module_file; do
  module_dir=${module_file%/go.mod}
  if [ "$module_dir" = "$module_file" ]; then
    module_dir=.
  fi
  echo "Testing Go module in $module_dir..."
  if [ "$module_dir" = "." ]; then
    go test . ./cmd/... ./internal/...
  else
    (cd "$module_dir" && go test ./...)
  fi
done

(
  cd frontend
  npm run check:native-dialogs
  npm run lint
  npm test -- --run
  npm run build
)
